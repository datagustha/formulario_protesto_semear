<!DOCTYPE html>
<html>
<head>
  <base target="_top">
  <meta charset="UTF-8" />
  <title>Cadastro de Evento - PROTESTO</title>
  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #ffffff;
      margin: 0;
      padding: 20px;
    }
    .container {
      max-width: 600px;
      margin: 0 auto;
      background: #fff;
      border-radius: 8px;
      box-shadow: 0 0 10px rgba(122, 58, 148, 0.3);
      padding: 40px 40px 50px 40px;
      border-top: 8px solid #7A3A94;
    }
    .logo-container {
      display: flex;
      justify-content: center;
      background-color: #ffffff;
      padding: 20px 0 30px 0;
    }
    .logo {
      max-width: 320px;
      height: auto;
    }
    h1 {
      text-align: center;
      color: #7A3A94;
      margin-bottom: 35px;
      font-weight: 700;
      font-size: 32px;
      letter-spacing: 1px;
    }
    label {
      color: #7A3A94;
      font-weight: 600;
      display: block;
      margin-bottom: 6px;
    }
    label.required::after {
      content: " *";
      color: #d22;
    }
    input[type="text"],
    input[type="date"],
    select,
    textarea {
      width: 100%;
      padding: 11px 12px;
      margin-bottom: 20px;
      border: 1px solid #ccc;
      border-radius: 4px;
      font-size: 16px;
      box-sizing: border-box;
      font-family: inherit;
      transition: border-color 0.3s ease;
    }
    input[type="text"]:focus,
    input[type="date"]:focus,
    select:focus,
    textarea:focus {
      border-color: #7A3A94;
      box-shadow: 0 0 6px #7A3A94cc;
      outline: none;
    }
    textarea {
      resize: vertical;
      min-height: 90px;
    }
    .btn-submit, .btn-buscar {
      padding: 14px 25px;
      font-size: 18px;
      font-weight: 700;
      cursor: pointer;
      border-radius: 6px;
      transition: background-color 0.3s ease;
    }
    .btn-submit {
      background-color: #7A3A94;
      color: white;
      border: none;
      width: 100%;
    }
    .btn-submit:hover {
      background-color: #5e2a6a;
    }
    .btn-buscar {
      background-color: #4CAF50;
      color: white;
      border: none;
      margin-bottom: 20px;
    }
    .btn-buscar:hover {
      background-color: #3e8e41;
    }
    .error-message {
      color: #d22;
      font-size: 13px;
      margin-top: -16px;
      margin-bottom: 16px;
      display: none;
    }
    .sucesso-msg, .erro-geral {
      padding: 14px;
      border-radius: 6px;
      font-weight: 700;
      margin-top: 20px;
      text-align: center;
      display: none;
    }
    .sucesso-msg {
      color: #2e7d32;
      background-color: #e8f5e9;
      border: 1px solid #c8e6c9;
    }
    .erro-geral {
      color: #d22;
      background-color: #fbeaea;
      border: 1px solid #f5c6cb;
    }
    .readonly-field {
      background-color: #f5f5f5;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="logo-container">
      <img src="https://i.ibb.co/xqDcRZ3q/SEMEARROXO-PNG.png" class="logo" alt="Logo SEMEAR">
    </div>

    <h1>Cadastro de Evento - PROTESTO</h1>

    <form id="formEvento" onsubmit="return enviarEvento();">
      <input type="hidden" id="empresa" name="empresa" value="semear" />

      <label for="operador" class="required">Operador</label>
      <input type="text" id="operador" name="operador" required list="listaOperadores" placeholder="Selecione ou digite..." />
      <datalist id="listaOperadores">
        <option value="2552FABRICIA">
        <option value="2552LIVIA">
        <option value="2552MARCUSVINI">
        <option value="2552ROSELI">
        <option value="2552VINASCIMENTO">
        <option value="2552GISELLECARDOSO">
        <option value="2552MYRIAM">
        <option value="2552ARIANE">
      </datalist>
      <div class="error-message" id="erro-operador">Por favor, selecione um operador válido.</div>

      <label for="contrato" class="required">Contrato</label>
      <div style="display: flex; gap: 10px;">
        <input type="text" id="contrato" name="contrato" required style="flex: 1;" />
        <button type="button" class="btn-buscar" onclick="buscarPorContrato()">Buscar</button>
      </div>
      <div class="error-message" id="erro-contrato">Campo obrigatório</div>

      <label for="cliente" class="required">Primeiro devedor (Cliente)</label>
      <input type="text" id="cliente" name="cliente" required class="readonly-field" readonly />
      <div class="error-message" id="erro-cliente">Campo obrigatório</div>

      <label for="cpf" class="required">CPF do Cliente</label>
      <input type="text" id="cpf" name="cpf" required class="readonly-field" readonly />
      <div class="error-message" id="erro-cpf">Campo obrigatório</div>

      <label for="telefone" class="required">Telefone de Contato</label>
      <select id="telefone" name="telefone" required>
        <option value="">-- Selecione após buscar o contrato --</option>
      </select>
      <div class="error-message" id="erro-telefone">Campo obrigatório</div>

      <label for="proposta_pagamento">Proposta para Pagamento</label>
      <input type="text" id="proposta_pagamento" name="proposta_pagamento" class="readonly-field" readonly />

      <label for="vencimento" class="required">Venc. Parc</label>
      <input type="date" id="vencimento" name="vencimento" required class="readonly-field" readonly />
      <div class="error-message" id="erro-vencimento">Campo obrigatório</div>

      <label for="nome_cartorio">Nome do Cartório</label>
      <input type="text" id="nome_cartorio" name="nome_cartorio" class="readonly-field" readonly />

      <label for="protocolo">Protocolo no cartório</label>
      <input type="text" id="protocolo" name="protocolo" class="readonly-field" readonly />

      <label for="data_pagamento">Data de Pagamento</label>
      <input type="date" id="data_pagamento" name="data_pagamento" onchange="calcularAtrasos()" />
      <div class="error-message" id="erro-data_pagamento">Insira uma data válida</div>

      <label for="atraso_contrato">Atraso Contrato (dias)</label>
      <input type="text" id="atraso_contrato" name="atraso_contrato" readonly class="readonly-field" />

      <label for="atraso_pgto">Atraso Pagamento (dias)</label>
      <input type="text" id="atraso_pgto" name="atraso_pgto" readonly class="readonly-field" />

      <label for="evento" class="required">Evento</label>
      <input type="text" id="evento" name="evento" required autocomplete="off" placeholder="Digite para buscar..." list="listaEventos" />
      <datalist id="listaEventos">
        <option value="Ligação completada">
        <option value="Ligação caiu">
        <option value="Caixa postal">
        <option value="Cliente não atendeu">
        <option value="Número fora de serviço">
        <option value="Número inválido">
        <option value="Telefone mudo">
        <option value="Telefone ocupado">
        <option value="Encaminhou para WhatsApp">
        <option value="Transferido para outro setor">
        <option value="Cliente não localizado">
        <option value="Cliente mudou de número">
        <option value="Cliente mudou de endereço">
        <option value="Cliente faleceu">
        <option value="Cliente se recusa a pagar">
        <option value="Cliente sem condições no momento">
        <option value="Acordo realizado por telefone">
        <option value="Acordo realizado por WhatsApp">
        <option value="Promessa de pagamento">
        <option value="Pagamento agendado">
        <option value="Pagamento efetuado ">
        <option value="Proposta no WhatsApp">
        <option value="Solicitou boleto por e-mail">
        <option value="Solicitou boleto por WhatsApp">
        <option value="Solicitou segunda via">
        <option value="Solicitou retorno em outro horário">
        <option value="Sem whatsapp">
        <option value="Dívida quitada">
        <option value="Encaminhado para jurídico">
        <option value="Parcelamento efetuado">
        <option value="Reencaminhado para cobrança">
        <option value="Registro apenas informativo">
        <option value="Envio de WhatsApp">
        <option value="Receptivo de WhatsApp">
      </datalist>
      <div class="error-message" id="erro-evento">Por favor, escolha um evento válido da lista.</div>

      <label for="canal" class="required">Canal</label>
      <select id="canal" name="canal" required>
        <option value="">-- Selecione --</option>
        <option value="WhatsApp">WhatsApp</option>
        <option value="Ligação">Ligação</option>
        <option value="E-mail">E-mail</option>
        <option value="SMS">SMS</option>
        <option value="Presencial">Presencial</option>
      </select>
      <div class="error-message" id="erro-canal">Campo obrigatório</div>

      <label for="status" class="required">Status</label>
      <select id="status" name="status" required>
        <option value="">-- Selecione o Status --</option>
        <option>Com Acordo</option>
        <option>Pago</option>
        <option>Em atraso</option>
        <option>Em dia</option>
      </select>
      <div class="error-message" id="erro-status">Campo obrigatório</div>

      <label for="observacoes">Observações</label>
      <textarea id="observacoes" name="observacoes"></textarea>

      <button type="submit" class="btn-submit">Registrar Evento</button>

      <div class="sucesso-msg" id="mensagem-sucesso"></div>
      <div class="erro-geral" id="mensagem-erro"></div>
    </form>
  </div>

  <script>
    // Funções de máscara
    function aplicarMascaraCPF(cpf) {
      if (!cpf) return '';
      cpf = cpf.replace(/\D/g, '');
      return cpf.replace(/(\d{3})(\d{3})(\d{3})(\d{2})/, '$1.$2.$3-$4');
    }

    function aplicarMascaraTelefone(tel) {
      if (!tel) return '';
      tel = tel.replace(/\D/g, '');
      if (tel.length === 11) {
        return tel.replace(/(\d{2})(\d{5})(\d{4})/, '($1) $2-$3');
      } else if (tel.length === 10) {
        return tel.replace(/(\d{2})(\d{4})(\d{4})/, '($1) $2-$3');
      }
      return tel;
    }

    function formatarMoedaFront(valor) {
      if (!valor) return '';
      // Converte para número e formata como moeda BR
      const numero = Number(valor.replace(/[^\d,]/g, '').replace(',', '.')) || 0;
      return numero.toLocaleString('pt-BR', {
        style: 'currency',
        currency: 'BRL'
      });
    }

    // Validação data no formato YYYY-MM-DD
    function isDataValida(dataStr) {
      if (!dataStr) return false;
      const data = new Date(dataStr);
      if (isNaN(data.getTime())) return false;
      if (!/^\d{4}-\d{2}-\d{2}$/.test(dataStr)) return false;
      return true;
    }

    // Busca dados do contrato
    function buscarPorContrato() {
      const contrato = document.getElementById('contrato').value.trim();
      if (!contrato) {
        document.getElementById('erro-contrato').style.display = 'block';
        return;
      }

      document.getElementById('erro-contrato').style.display = 'none';
      
      google.script.run
        .withSuccessHandler(preencherDadosContrato)
        .withFailureHandler(mostrarErroBusca)
        .buscarDadosContrato(contrato);
    }

    // Preenche os campos com os dados do contrato
    function preencherDadosContrato(dados) {
      if (!dados) {
        mostrarErroBusca('Contrato não encontrado');
        return;
      }

      document.getElementById('cliente').value = dados.cliente || '';
      document.getElementById('cpf').value = aplicarMascaraCPF(dados.cpf || '');
      
      // Preenche dropdown de telefones
      const selectTel = document.getElementById('telefone');
selectTel.innerHTML = '';

// Adiciona "Sem telefone" como uma das opções (com valor real!)
const optionPadrao = document.createElement('option');
optionPadrao.value = 'Sem telefone';  // <- aqui está a diferença
optionPadrao.textContent = 'Sem telefone';
selectTel.appendChild(optionPadrao);

if (dados.telefones && dados.telefones.length > 0) {
  dados.telefones.forEach(tel => {
    const option = document.createElement('option');
    option.value = tel;
    option.textContent = tel;
    selectTel.appendChild(option);
  });
}

      document.getElementById('vencimento').value = dados.vencParc || '';
      document.getElementById('proposta_pagamento').value = formatarMoedaFront(dados.propostaPagamento || '');
      document.getElementById('nome_cartorio').value = dados.cartorio || '';
      document.getElementById('protocolo').value = dados.protocolo || '';
      
      // Calcula atraso do contrato
      calcularAtrasos();
    }

    // Calcula atrasos automaticamente
    function calcularAtrasos() {
      const vencParc = new Date(document.getElementById('vencimento').value);
      const dataPgto = new Date(document.getElementById('data_pagamento').value);
      const hoje = new Date();

      if (!isNaN(vencParc.getTime())) {
        const atrasoContrato = Math.ceil((hoje - vencParc) / (86400000));
        document.getElementById('atraso_contrato').value = atrasoContrato > 0 ? atrasoContrato : '0';
      }

      if (!isNaN(dataPgto.getTime()) && !isNaN(vencParc.getTime())) {
        const atrasoPgto = Math.ceil((dataPgto - vencParc) / (86400000));
        document.getElementById('atraso_pgto').value = atrasoPgto > 0 ? atrasoPgto : '0';
      }
    }

    // Mostra erro na busca
    function mostrarErroBusca(mensagem) {
      const msgErro = document.getElementById('mensagem-erro');
      msgErro.textContent = mensagem || 'Erro ao buscar contrato';
      msgErro.style.display = 'block';
      setTimeout(() => msgErro.style.display = 'none', 5000);
    }

    // Envia o formulário
    function enviarEvento() {
      const form = document.getElementById('formEvento');

      // Limpa mensagens de erro
      document.querySelectorAll('.error-message').forEach(e => e.style.display = 'none');
      document.getElementById('mensagem-sucesso').style.display = 'none';
      document.getElementById('mensagem-erro').style.display = 'none';

      const camposObrigatorios = ['operador', 'contrato', 'cliente', 'cpf', 'telefone', 'vencimento', 'evento', 'canal', 'status'];
      let valido = true;

      camposObrigatorios.forEach(campo => {
        const el = document.getElementById(campo);
        if (!el || !el.value || el.value.trim() === "") {
          const erroEl = document.getElementById('erro-' + campo);
          if (erroEl) erroEl.style.display = 'block';
          valido = false;
        }
      });

      // Valida operador
      const operador = document.getElementById('operador').value.trim();
      const operadoresPermitidos = [
        "2552FABRICIA", "2552LIVIA", "2552MARCUSVINI", "2552ROSELI",
        "2552VINASCIMENTO", "2552GISELLECARDOSO", "2552MYRIAM", "2552ARIANE"
      ];
      if (!operadoresPermitidos.includes(operador)) {
        document.getElementById('erro-operador').style.display = 'block';
        valido = false;
      }

      // Valida evento
      const eventoInput = document.getElementById('evento');
      const listaEventos = Array.from(document.querySelectorAll('#listaEventos option')).map(o => o.value);
      if (!listaEventos.includes(eventoInput.value.trim())) {
        document.getElementById('erro-evento').style.display = 'block';
        valido = false;
      }

      // Valida datas
      const vencimento = document.getElementById('vencimento').value;
      if (!isDataValida(vencimento)) {
        document.getElementById('erro-vencimento').style.display = 'block';
        valido = false;
      }

      const data_pagamento = document.getElementById('data_pagamento').value;
      if (data_pagamento && !isDataValida(data_pagamento)) {
        document.getElementById('erro-data_pagamento').style.display = 'block';
        valido = false;
      }

      if (!valido) return false;

      let dados = {};
      new FormData(form).forEach((valor, chave) => dados[chave] = valor);
      if (!dados['data_pagamento']) dados['data_pagamento'] = 'Sem Pgto';

      google.script.run
        .withSuccessHandler(res => {
          if(res.sucesso) {
            form.reset();
            const msgSucesso = document.getElementById('mensagem-sucesso');
            msgSucesso.textContent = res.mensagem || "Registro realizado com sucesso!";
            msgSucesso.style.display = 'block';
          } else {
            const msgErro = document.getElementById('mensagem-erro');
            msgErro.textContent = res.mensagem || "Erro ao salvar registro.";
            msgErro.style.display = 'block';
          }
        })
        .withFailureHandler(err => {
          const msgErro = document.getElementById('mensagem-erro');
          msgErro.textContent = 'Erro inesperado ao salvar: ' + err.message;
          msgErro.style.display = 'block';
        })
        .SalvarEvento(dados);

      return false;
    }
  </script>
</body>
</html>
