/**************************
 * FUNÇÕES DE FORMATAÇÃO *
 **************************/

function formatarDataHora(data) {
  if (!data) return '';
  const d = new Date(data);
  const dia = String(d.getDate()).padStart(2, '0');
  const mes = String(d.getMonth() + 1).padStart(2, '0');
  const ano = d.getFullYear();
  const hora = String(d.getHours()).padStart(2, '0');
  const min = String(d.getMinutes()).padStart(2, '0');
  return `${dia}/${mes}/${ano} ${hora}:${min}`;
}

function formatarData(data) {
  if (!data) return '';
  const d = new Date(data);
  const dia = String(d.getDate()).padStart(2, '0');
  const mes = String(d.getMonth() + 1).padStart(2, '0');
  const ano = d.getFullYear();
  return `${dia}/${mes}/${ano}`;
}

function converterData(valorCelula) {
  if (!valorCelula) return '';

  if (valorCelula instanceof Date && !isNaN(valorCelula.getTime())) {
    return valorCelula.toISOString().split('T')[0];
  }

  if (typeof valorCelula === 'number' && valorCelula > 0) {
    return new Date((valorCelula - 25569) * 86400 * 1000).toISOString().split('T')[0];
  }

  if (typeof valorCelula === 'string' && valorCelula.match(/^\d{2}\/\d{2}\/\d{4}$/)) {
    const [dia, mes, ano] = valorCelula.split('/');
    return new Date(ano, mes - 1, dia).toISOString().split('T')[0];
  }

  return '';
}

function formatarTelefone(tel) {
  if (!tel) return '';
  let telStr = tel.toString().replace(/\D/g, '');
  if (telStr.length === 10) return telStr.replace(/(\d{2})(\d{4})(\d{4})/, '($1) $2-$3');
  if (telStr.length === 11) return telStr.replace(/(\d{2})(\d{5})(\d{4})/, '($1) $2-$3');
  return telStr;
}

function formatarCPF(cpf) {
  if (!cpf) return '';
  const cpfStr = cpf.toString().replace(/\D/g, '');
  return cpfStr.replace(/(\d{3})(\d{3})(\d{3})(\d{2})/, '$1.$2.$3-$4');
}

